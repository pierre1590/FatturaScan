{
  "name": "fatturascan",
  "productName": "FatturaScan",
  "version": "1.1.2",
  "private": true,
  "description": "FatturaScan — Acquisisce fatture scansionate, ne estrae gli importi e crea un riepilogo Excel.",
  "keywords": [
    "fatture",
    "scansione",
    "acquisizione documenti",
    "OCR",
    "estrazione dati",
    "imponibile",
    "C.A.P.",
    "bollo",
    "riepilogo Excel"
  ],
  "license": "MIT",
  "author": {
    "name": "Piero Sabino",
    "email": "piero.sa@icloud.com"
  },
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "dist:win": "electron-builder --win nsis",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "it.pierosabino.fatturascan",
    "productName": "FatturaScan",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.86.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
